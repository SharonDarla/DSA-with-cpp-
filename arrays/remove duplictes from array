// OPTIMAL==> USING TWO POINTERS -- T.C = O(N) , S.C = O(1)

int removeDuplicates(int arr[], int n){
    int i=0; // points at starting index assuming first ele is always unique
    for(int j=1;j<n;j++){
        if(arr[j]!=arr[i]){
            arr[i+1]=arr[j];
            i++;
        }
    }
    return i+1;
}
