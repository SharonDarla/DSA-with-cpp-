#include<bits/stdc++.h>
using namespace std;
int main(){
    string s;
    cin>>s;
    int hash[26]={0};
    for(int i=0;i<s.size();i++){
        hash[s[i]-'a']++;
    }
    
    int  q;
    cin>>q;
    while(q--){
        char c; cin>>c;
        cout<<hash[c-'a']<<endl;
    }
    return 0;
}


// this code , processes all inputs at once and produces all outputs at once
#include<bits/stdc++.h>
using namespace std;
int main(){
    string s;
    cin>>s;
    int hash[26]={0};
    for(int i=0;i<s.size();i++){
        hash[s[i]-'a']++;
    }
    
    int  q;
    cin>>q;
    char queries[q];
    
    for(int i = 0; i < q; i++) {
        cin >> queries[i];
    }

    // then print all answers at once
    for(int i = 0; i < q; i++) {
        cout << hash[queries[i] - 'a'] << endl;
    }
    return 0;
}
