//taking all queries at once, and stroing them in arr and displaying in console at once

#include <bits/stdc++.h>
using namespace std;

int main(){
    int n;
    cin >> n;
    int arr[n];
    for(int i = 0; i < n; i++){
        cin >> arr[i];
    }
    
    // pre-compute
    int hash[13] = {0};
    for(int i = 0; i < n; i++){
        hash[arr[i]]++;
    }
    
    int q;
    cin >> q;
    vector<int> queries(q);
    // Take all queries at once
    for(int i = 0; i < q; i++){
        cin >> queries[i];
    }

    // Print all answers at once
    for(int i = 0; i < q; i++){
        cout << queries[i] << "->" << hash[queries[i]] << endl;
    }

    return 0;
}
