// CHARACTER HASHING

#include<bits/stdc++.h>
using namespace std;
int main(){
  string s;
  cin>>s;
  
  map<char,int>mpp;
  for(int i=0;i<s.size();i++){
      mpp[s[i]]++;
  }
  
  int q;
  cin>>q;
  vector<char>que(q);
   for(int i=0;i<q;i++){
      cin>>que[i];
  }
  cout<<"the queries are: "<<endl;
  for(int i=0;i<q;i++){
       cout<<que[i]<<"->"<<mpp[que[i]]<<endl;
  }
     
    return 0;
}
