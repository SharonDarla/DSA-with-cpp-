Void pattern22(int n){
    int num=n;
    int size=2*n-1;
    int arr[size][size];
    int top=0, bot=size-1, left=0, right=size-1;
    while(num>0){
        //top row
        for(int i=left;i<=right;i++){
            arr[top][i]=num;
        }
        top++;
        // right col
        for(int i=top; i<=bot;i++){
            arr[i][right]=num;
        }
        right--;
        // bottom
        for(int i=right;i>=left;i--){
            arr[bot][i]=num;
        }
        bot--;
        // left col
        for(int i=bot;i>=top;i--){
           arr[i][left]=num;
        }
        left++;
        num--;
    }
    for(int i=0;i<size;i++){
        for(int j=0;j<size;j++){
            cout<<arr[i][j];
        }
        cout<<endl;
    }
}

