//Same as above but condition changes when we start iteration from 1 -> n-1 instead of 0 -> n

#include <iostream>
using namespace std;

void printStarDiamond(int N) {
    // Upper half
    for (int i = 1; i <= N; i++) {
        // Print spaces
        for (int j = 1; j <= N - i; j++)
            cout << " ";
        // Print stars
        for (int j = 1; j <= (2 * i) - 1; j++)
            cout << "*";
        cout << endl;
    }

    // Lower half (same as upper half)
    for (int i = N; i >= 1; i--) {
        // Print spaces
        for (int j = 1; j <= N - i; j++)
            cout << " ";
        // Print stars
        for (int j = 1; j <= (2 * i) - 1; j++)
            cout << "*";
        cout << endl;
    }
}

int main() {
    int N;
    cin >> N;
    printStarDiamond(N);
    return 0;
}

