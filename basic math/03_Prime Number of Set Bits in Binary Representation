#include <iostream>
#include <vector>
using namespace std;

const int MAX = 1e6 + 1;

// Precompute set bits for all numbers up to MAX
vector<int> precomputeSetBits() {
    vector<int> setBits(MAX, 0);
    for (int i = 1; i < MAX; i++) {
        setBits[i] = setBits[i >> 1] + (i & 1);
    }
    return setBits;
}

// Precompute primes up to 20
vector<bool> precomputePrimes() {
