int countPrimeSetBits(int left, int right) {
    vector<int> setBits = precomputeSetBits();
    vector<bool> isPrime = precomputePrimes();

    int count = 0;
    for (int n = left; n <= right; n++) {
        if (isPrime[setBits[n]]) {
