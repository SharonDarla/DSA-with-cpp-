#include <bits/stdc++.h>
using namespace std;

void insertionSort(vector<int>&arr,int i, int n){
    // base case
    if(i==n)return;
    
    int j=i;
    while(j>0 && arr[j-1]>arr[j]){
        swap(arr[j],arr[j-1]);
        j--;
    }
    
    insertionSort(arr,i+1,n);
}


int main()
{
    int n; cin>>n;
    vector<int> arr(n);
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    cout<<"before sorting: "<<endl;
    for(int i=0;i<n;i++){
        cout<<arr[i]<<" ";
    }
    cout<<endl;
    
    insertionSort(arr,0,n);
    
    cout<<"after sorting: "<<endl;
    for(int i=0;i<n;i++){
        cout<<arr[i]<<" ";
    }

    return 0;
}
