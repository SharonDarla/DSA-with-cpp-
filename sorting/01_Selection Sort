#include<bits/stdc++.h>
using namespace std;

void selectionSort(int arr[],int n){
    // loop till n-2 bcz when i is at before last ele, we use j as j+1 
    // to compare with prev ele 'i', if i is till n-1 ie., =n-1 then j is out of bounds
    for(int i=0;i<n-1;i++){
        int mini=i;
        for(int j=i+1;j<n;j++){
            if(arr[j]<arr[mini]){
                mini=j;
            }
        }
        // using mini variable explicitly before initiating inner loop for finding smallest value to reduce 
        // uncesessary swap because in inner loop, once we find the mini value we come out of loop and swap once
        swap(arr[i],arr[mini]);
    }
}

int main() {
	int n;
	cout<<"enter the size of array: ";
	cin>>n;
	int arr[n];
	for(int i=0; i<n; i++) {
		cin>>arr[i];
	}
	cout<<"before sorting: \n";
	for(int i=0; i<n; i++) {
		cout<<arr[i]<<" ";
	}
    selectionSort(arr,n);
    cout<<endl;
    cout<<"after sorting: \n";
    for(int i=0;i<n;i++){
        cout<<arr[i]<<" ";
    }
	return 0;
}








