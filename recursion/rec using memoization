class Solution {
public:

    int climbStairs(int n) {
        unordered_map<int,int>mp;
        return climbStairs(n,mp); //calling the below function
    }
    int climbStairs(int n,unordered_map<int,int> mp){
        if(n<0){return 0;} //handling negetive values
        if(n==0 || n==1){return 1;} //base cond
        if(mp.find(n)==mp.end()){ //if key not found in map, compute and add that key & its corresp value
            mp[n]=climbStairs(n-1,mp)+climbStairs(n-2,mp);
        }
        return mp[n];
    }  
};



